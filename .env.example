# Used by docker-compose.yml. Copy to `.env` to override — compose works
# with these defaults even without a `.env` file.
#
# Development-only credentials: this project has no authentication in its
# first version (see docs/WEB_ARCHITECTURE.md section 6) and is meant to
# run behind a firewall / locally, not exposed publicly — never reuse these
# for a real deployment.
POSTGRES_USER=donquixote
POSTGRES_PASSWORD=donquixote
POSTGRES_DB=donquixote
