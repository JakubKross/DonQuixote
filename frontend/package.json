{
  "name": "donquixote-frontend",
  "private": true,
  "version": "0.1.0",
  "type": "module",
  "scripts": {
    "postinstall": "mkdir -p public/maplibre-gl && cp node_modules/maplibre-gl/dist/maplibre-gl-worker.mjs node_modules/maplibre-gl/dist/maplibre-gl-shared.mjs public/maplibre-gl/",
    "dev": "vite",
    "build": "tsc -b && vite build",
    "preview": "vite preview",
    "generate:api-types": "openapi-typescript openapi.json -o src/api/schema.d.ts"
  },
  "dependencies": {
    "maplibre-gl": "^6.12.0",
    "react": "^18.3.1",
    "react-dom": "^18.3.1",
    "react-router-dom": "^7.18.4"
  },
  "devDependencies": {
    "@types/geojson": "^7946.0.14",
    "@types/react": "^18.3.12",
    "@types/react-dom": "^18.3.1",
    "@vitejs/plugin-react": "^4.7.0",
    "openapi-typescript": "^7.4.4",
    "typescript": "^5.6.3",
    "vite": "^6.4.4"
  }
}
